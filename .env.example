# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# ID чата, куда бот присылает заявки (личка админа или группа менеджеров).
# Чтобы узнать ID: напишите боту @userinfobot (для лички) или добавьте бота
# в группу и посмотрите ID в логах бота. ID группы — отрицательное число.
ADMIN_CHAT_ID=-1001234567890

# (необязательно) ID пользователей-админов через запятую.
# Только они смогут отвечать клиентам, если ADMIN_CHAT_ID — группа с посторонними.
# Если оставить пустым, отвечать сможет любой участник ADMIN_CHAT_ID.
ADMIN_IDS=

# (необязательно) Наценка обменника к рыночному курсу, в процентах.
# Всегда в вашу пользу: клиент получает чуть меньше / платит чуть больше.
# Например, 2.5 = наценка 2,5%. По умолчанию 0 (чистый рыночный курс).
EXCHANGE_MARKUP_PERCENT=0

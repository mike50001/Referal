# === Binance API ===
# Ключи создаются в аккаунте Binance.
# Для TESTNET: https://testnet.binancefuture.com/  ->  API Key
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# true  -> торговля на тестовой сети (бумажные деньги, безопасно)
# false -> РЕАЛЬНЫЕ ДЕНЬГИ на mainnet
USE_TESTNET=true

# Адрес фьючерсного тестнета Binance (переехал на demo-fapi.binance.com).
# Меняй, только если Binance снова сменит адрес.
TESTNET_BASE_URL=https://demo-fapi.binance.com

# === Торговые параметры ===
SYMBOL=BTCUSDT
INTERVAL=15m          # таймфрейм свечей: 1m,5m,15m,1h,4h ...
LEVERAGE=3            # плечо
MARGIN_TYPE=ISOLATED  # ISOLATED или CROSSED

# === Стратегия ===
# ema_rsi  -> пересечение EMA + фильтр RSI
# fast_rsi -> Fast RSI 2.0 (RSI + EMA размера тела свечи)
STRATEGY=ema_rsi

# === Риск-менеджмент ===
RISK_PER_TRADE=0.01   # доля депозита на сделку (0.01 = 1%)
STOP_LOSS_PCT=0.015   # стоп-лосс 1.5% от цены (если ATR-стоп выключен)
TAKE_PROFIT_PCT=0.03  # тейк-профит 3% от ЦЕНЫ (если TAKE_PROFIT_ROI=0 и ATR выкл)
# Тейк по доходности на МАРЖУ с учётом плеча (0 = выкл). Приоритетнее TAKE_PROFIT_PCT.
# Пример: 0.03 при плече x3 => бот закроет прибыль на ~1% движения цены (= +3% к марже).
TAKE_PROFIT_ROI=0.0
MAX_POSITION_USDT=100 # максимальный номинал позиции в USDT
MAX_DRAWDOWN_PCT=0.25 # стоп новых сделок при просадке от пика (0.25 = 25%, 0 = выкл)

# === Индикаторы: EMA/RSI стратегия ===
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# === Индикаторы: Fast RSI 2.0 ===
RSI_LIMIT=40          # порог RSI (вход в long < 40, в short > 60)
BODY_EMA=30           # период EMA среднего размера тела свечи

# === ATR-стоп (динамический) ===
USE_ATR_STOP=false    # true -> SL/TP считаются от ATR, а не от фикс. %
ATR_PERIOD=14
ATR_SL_MULT=2.0       # стоп-лосс = 2 * ATR
ATR_TP_MULT=4.0       # тейк-профит = 4 * ATR (R:R = 1:2)

# === Трендовый фильтр старшего ТФ ===
TREND_FILTER=false    # true -> не входить против тренда старшего ТФ
TREND_INTERVAL=4h     # таймфрейм для определения тренда
TREND_EMA=200         # EMA для тренда: цена выше -> long, ниже -> short

# === Трейлинг-стоп ===
# true -> вместо фикс. тейка ставится трейлинг: биржа двигает стоп за ценой
# и закрывает позицию при откате на TRAILING_CALLBACK% от лучшей цены.
# Жёсткий STOP_LOSS_PCT при этом остаётся как защита.
TRAILING_STOP=false
TRAILING_CALLBACK=1.0 # откат в % (допустимо 0.1..5)

# === Прочее ===
POLL_INTERVAL_SEC=30  # как часто опрашивать рынок (сек)
DRY_RUN=false         # true -> только сигналы в лог, без реальных ордеров
LOG_LEVEL=INFO

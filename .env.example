# Скопируй этот файл в .env и подставь свои значения.
# Файл .env НЕЛЬЗЯ выкладывать в git — он уже в .gitignore.

# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=сюда_вставь_токен_от_BotFather

# Ключ OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=сюда_вставь_ключ_OpenAI

# Необязательно: модель OpenAI (по умолчанию gpt-4o-mini — умная и недорогая)
OPENAI_MODEL=gpt-4o-mini

# Необязательно: сколько последних сообщений помнить в разговоре
HISTORY_LIMIT=20

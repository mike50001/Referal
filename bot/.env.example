# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Твой Telegram user id (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789

# ===== Панель 3x-ui =====
# Базовый адрес панели ВМЕСТЕ с web base path, БЕЗ слэша в конце.
# Пример: http://77.221.159.3:2053/e1a0iilyM0VFJHE54q
XUI_BASE_URL=http://77.221.159.3:2053/e1a0iilyM0VFJHE54q
XUI_USERNAME=Admin
XUI_PASSWORD=changeme
# ID reality-подключения в панели (обычно 1 — колонка ID во «Входящие»)
XUI_INBOUND_ID=1

# IP сервера, который попадёт в ссылку vless://
SERVER_IP=77.221.159.3
# Flow клиента (как в панели). Оставь пустым, если Flow не задавали.
CLIENT_FLOW=xtls-rprx-vision

# ===== Бесплатный пробный период =====
# Сколько дней бесплатно даётся каждому новому пользователю при первом запуске
TRIAL_DAYS=7

# ===== Реферальная система (в днях) =====
# Сколько дней получает пригласивший за каждого приглашённого
REFERRAL_DAYS=7

# ===== Оплата (через администратора) =====
# Валюта для отображения
CURRENCY=руб.
# Твой контакт для оплаты: @username или ссылка https://t.me/username
ADMIN_CONTACT=@your_username

# ===== Уведомление об окончании подписки =====
# За сколько дней до конца предупреждать пользователя
EXPIRY_WARN_DAYS=2

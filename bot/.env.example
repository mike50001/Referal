# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Твой Telegram user id (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789

# ===== Панель Remnawave (актуальный движок) =====
# Базовый адрес панели, БЕЗ /api и БЕЗ слэша в конце.
# Пример: https://panel.cashxyz.store
REMNA_BASE_URL=https://panel.cashxyz.store
# API-токен из панели: Настройки → API токены (Bearer)
REMNA_TOKEN=eyJ...
# UUID внутреннего сквада, куда добавляем пользователей (все ноды/локации).
# Взять: GET /api/internal-squads → поле uuid у нужного сквада.
REMNA_SQUAD_UUID=edd22baa-0a4d-486a-8d4a-e769b06bedf6

# ===== Панель 3x-ui (устаревшее, не обязательно) =====
# Оставлено для совместимости. Для Remnawave эти переменные не нужны.
#XUI_BASE_URL=http://77.221.159.3:2053/e1a0iilyM0VFJHE54q
#XUI_USERNAME=Admin
#XUI_PASSWORD=changeme
#XUI_INBOUND_ID=1
#SERVER_IP=77.221.159.3
#CLIENT_FLOW=xtls-rprx-vision

# ===== Бесплатный пробный период =====
# Сколько дней бесплатно даётся каждому новому пользователю при первом запуске
TRIAL_DAYS=7

# ===== Реферальная система (в днях) =====
# Сколько дней получает пригласивший за каждого приглашённого
REFERRAL_DAYS=7

# ===== Оплата (через администратора) =====
# Валюта для отображения
CURRENCY=руб.
# Твой контакт для оплаты: @username или ссылка https://t.me/username
ADMIN_CONTACT=@your_username

# ===== Уведомление об окончании подписки =====
# За сколько дней до конца предупреждать пользователя
EXPIRY_WARN_DAYS=2

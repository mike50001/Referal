# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=123456:AA...

# Твой Telegram user id (узнать: @userinfobot). Можно несколько через запятую.
ADMIN_IDS=123456789

# ===== Панель 3x-ui =====
# Базовый адрес панели ВМЕСТЕ с web base path, БЕЗ слэша в конце.
# Пример: http://77.221.159.3:2053/e1a0iilyM0VFJHE54q
XUI_BASE_URL=http://77.221.159.3:2053/e1a0iilyM0VFJHE54q
XUI_USERNAME=Admin
XUI_PASSWORD=changeme
# ID reality-подключения в панели (обычно 1 — колонка ID во «Входящие»)
XUI_INBOUND_ID=1

# IP сервера, который попадёт в ссылку vless://
SERVER_IP=77.221.159.3
# Flow клиента (как в панели). Оставь пустым, если Flow не задавали.
CLIENT_FLOW=xtls-rprx-vision

# ===== Реферальная система =====
# Сколько процентов от платежа друга падает на баланс пригласившего
REFERRAL_PERCENT=20

# ===== Оплата (ручное подтверждение) =====
# Валюта для отображения
CURRENCY=руб.
# Реквизиты для оплаты (покажутся юзеру). Впиши свои: карта / USDT / СБП и т.п.
PAYMENT_DETAILS=USDT (TRC20): TXxxxxxxxxxxxxxxxxxxxxxxxxxxxx\nИли карта: 2200 0000 0000 0000 (Иван И.)
